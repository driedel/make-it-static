# Pylint configuration for the make-it-static codebase.
# Modern Pylint (3.x) run with all service dependencies installed (see tests.yml).
# The project has no package structure: tests import `main` (from api/) and the
# worker modules directly, relying on sys.path setup from tests/conftest.py.
# Mirror that here (absolute paths — relative ones break astroid's import
# resolution for site-packages) so pylint can resolve those imports.

[MAIN]
py-version = 3.12
init-hook = 'import sys, os; sys.path[:0] = [os.path.join(os.getcwd(), "api"), os.path.join(os.getcwd(), "worker")]'

# Use multiple processes to speed up Pylint (0 = auto-detect, capped at 4).
jobs = 0

# Files or directories to be skipped. They should be base names, not paths.
ignore = .git,__pycache__,.venv,venv

[MESSAGES CONTROL]
disable =
    # tests/test_api.py intentionally patches redis/rq before importing main
    import-outside-toplevel,
    # the pipeline deliberately continues on per-file errors (postprocess/optimize)
    broad-exception-caught,
    # test option dicts and HTML fixtures legitimately repeat across test files
    duplicate-code,
    # many false positives with typed containers and optional types
    unsubscriptable-object,
    # pytest fixtures trigger this
    redefined-outer-name,

[FORMAT]
max-line-length = 100
max-module-lines = 1000

[BASIC]
good-names = i,j,k,ex,Run,_,id,fn,fp

[DESIGN]
# The pipeline functions track several counters/paths; these thresholds keep
# them enforceable without forcing artificial restructuring.
max-args = 10
max-locals = 20
max-returns = 10
max-statements = 60
max-parents = 7
max-attributes = 10
min-public-methods = 0
max-public-methods = 30

[TYPECHECK]
# Members set dynamically or provided by compiled extensions that astroid
# cannot introspect (minify_html is a Rust extension).
generated-members = boto3.client, boto3.resource, minify_html.minify
